# Application Environment
TEST_ENV=local
BASE_URL=http://127.0.0.1:4567
API_URL=http://127.0.0.1:4567

# LTI Tool Configuration
# The Client ID registered in your LMS (Canvas)
CLIENT_ID=10000000000001

# The URL of your local Sinatra app as seen by your browser
TOOL_HOST=192.168.2.92:4567

# The URL of your LMS (Canvas) as seen by your browser
LMS_BROWSER_URL=http://canvas.docker

# The Issuer URL of your LMS (for server-to-server validation)
LMS_ISSUER=http://192.168.2.92:3000

# Optional service token overrides for LMSes that use a separate OAuth audience.
# LMS_TOKEN_ENDPOINT=http://canvas.docker/login/oauth2/token
# LMS_TOKEN_AUDIENCE=http://canvas.docker/login/oauth2/token

# Optional key overrides. Persist your dev key somewhere stable if you want a
# pasted Public JWK to keep working across restarts.
TOOL_KEY_KID=tool-key
# TOOL_PRIVATE_KEY_PATH=/absolute/path/to/tool-private-key.pem
# TOOL_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
